# ---------------------------------------------------------------------------
# Production .env for the Cloudflare + VPS + OpenRouter deployment.
# Copy to `.env` on the VPS and fill in the real secrets. Do NOT commit `.env`.
# See DEPLOY.md for the full walkthrough (domain: polyglotlearning.com).
# ---------------------------------------------------------------------------

# nginx proxy is the public entrypoint. Cloudflare talks to the origin over
# these ports, so serve on the real web ports (not the Spark dev ports).
POLYGLOT_FRONTEND_PORT=80
POLYGLOT_HTTPS_PORT=443

# Internal API port (host-side). Not exposed publicly by Cloudflare; nginx
# proxies /api and /ws to it. Any free host port is fine.
POLYGLOT_BACKEND_PORT=18082

# Legacy build arg — the live frontend is origin-relative and ignores this, but
# docker-compose still passes it. Point it at the domain for correctness.
POLYGLOT_PUBLIC_API_URL=https://polyglotlearning.com

# Database (internal-only, not bound to a host port). USE A STRONG PASSWORD.
POLYGLOT_DB_USER=polyglot
POLYGLOT_DB_PASSWORD=CHANGE_ME_use_a_long_random_secret
POLYGLOT_DB_NAME=polyglot

# ---- LLM via OpenRouter (replaces the DGX vLLM) ----
POLYGLOT_VLLM_URL=https://openrouter.ai/api/v1
POLYGLOT_AI_MODEL=google/gemini-2.5-flash-lite
POLYGLOT_OPENAI_API_KEY=sk-or-CHANGE_ME

# ---- Cloudflare Tunnel (home / NAT server only) ----
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
# Leave blank if you're on a public-IP VPS (A-record) instead of a tunnel.
POLYGLOT_TUNNEL_TOKEN=
