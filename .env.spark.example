# Copy to .env.spark on the DGX Spark and adjust if needed.
# Do not commit the real .env.spark file.

# Public host ports chosen to avoid the documented Spark ports:
# 3000 Open WebUI, 6767 nv-live frontend, 8767 nv-live API, 9443 Portainer, etc.
POLYGLOT_FRONTEND_PORT=18080
POLYGLOT_BACKEND_PORT=18082

# The browser needs a URL that points to the Spark, not to localhost on the user's laptop.
POLYGLOT_PUBLIC_API_URL=http://10.74.10.244:18082

# Polyglot-owned database. This database is internal-only; it is not bound to a host port.
POLYGLOT_DB_USER=polyglot
POLYGLOT_DB_PASSWORD=change-this-before-deploy
POLYGLOT_DB_NAME=polyglot

# Existing Spark vLLM service. Do not route application traffic through Open WebUI.
POLYGLOT_VLLM_URL=http://host.docker.internal:8000/v1
POLYGLOT_AI_MODEL=qwen2.5-7b-fp8
POLYGLOT_OPENAI_API_KEY=token-nv
